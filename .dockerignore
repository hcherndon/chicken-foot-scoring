# Everything here is either rebuilt inside the image or belongs to a platform
# the web build never touches. Keeping it out matters for more than speed:
# .dart_tool holds a package_config.json full of absolute host paths, and
# copying that over the one `flutter pub get` just wrote breaks the build.

.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies

# Generated by build_runner. The image regenerates these so the drift code
# always matches the pubspec it was built against.
*.g.dart

# Native platform folders — not read by `flutter build web`.
android/
ios/
macos/
windows/
linux/

.git/
.github/
.idea/
.vscode/
.DS_Store
*.iml
*.swp
Dockerfile
.dockerignore
